# Caddy server config para el frontend público.
#
# - Sirve estáticos en /
# - SPA fallback: cualquier ruta que NO matchee un archivo cae a
#   index.html (necesario para /m/CODE → index.html parsea el code).
# - Headers de seguridad razonables.
# - Compresión gzip + zstd.
# - Cache largo para assets con nombre versionado (hash en el filename).
#   El Dockerfile ahora renombra app.js a app.<hash-del-contenido>.js en
#   cada build y actualiza la referencia en index.html — como el NOMBRE
#   cambia solo cuando cambia el contenido, cachear "immutable" por 1 año
#   es seguro: un cliente nunca puede terminar con la copia vieja de un
#   archivo bajo una URL que ahora apunta a algo distinto. index.html
#   (que sí conserva siempre el mismo nombre) es el único que necesita
#   revalidar siempre — es lo que le dice al cliente CUÁL es el nombre
#   vigente de app.js en cada visita.

:80 {
	root * /srv

	encode zstd gzip

	# Headers de seguridad (defensa en profundidad — el endpoint
	# público del API también valida).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Tailwind CDN + el backend API + CDN de fonts.
		# Si cambiás el dominio del backend, ajustá `connect-src`.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data: https:; connect-src 'self' https://food.plat.baudity.com; font-src 'self' data:; frame-ancestors 'none'"
		# index.html no se cachea para poder deployar fixes rápido.
		?Cache-Control "no-cache"
	}

	# Cache largo para binarios estáticos (imágenes, fuentes) y para el
	# JS con nombre hasheado (app.<hash>.js) — todos son "versionados":
	# si el contenido cambia, la URL cambia con él.
	@assets path *.png *.jpg *.svg *.webp *.woff *.woff2 *.js
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback — sirve index.html para rutas sin archivo.
	try_files {path} /index.html

	file_server
}
