# Caddy server config para el frontend público.
#
# - Sirve estáticos en /
# - SPA fallback: cualquier ruta que NO matchee un archivo cae a
#   index.html (necesario para /m/CODE → index.html parsea el code).
# - Headers de seguridad razonables.
# - Compresión gzip + zstd.
# - Cache largo SOLO para assets con nombre versionado (hash en el
#   filename). `app.js` NO está versionado (el Dockerfile lo copia tal
#   cual, mismo nombre en cada deploy) — cachearlo "immutable" por 1 año
#   dejaba a los clientes con la versión vieja indefinidamente después de
#   cada actualización, hasta que alguien hiciera un hard refresh. Ahora
#   usa la misma política que index.html: siempre revalida contra el
#   servidor (Caddy ya manda ETag/Last-Modified, así que revalidar es
#   barato — normalmente un 304 sin re-descargar nada).

:80 {
	root * /srv

	encode zstd gzip

	# Headers de seguridad (defensa en profundidad — el endpoint
	# público del API también valida).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Tailwind CDN + el backend API + CDN de fonts.
		# Si cambiás el dominio del backend, ajustá `connect-src`.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; img-src 'self' data: https:; connect-src 'self' https://food.plat.baudity.com; font-src 'self' data:; frame-ancestors 'none'"
		# index.html no se cachea para poder deployar fixes rápido.
		?Cache-Control "no-cache"
	}

	# Cache largo SOLO para binarios estáticos que sí cambian de nombre al
	# cambiar (imágenes, fuentes) — nunca .js/.css, que hoy no están
	# versionados.
	@assets path *.png *.jpg *.svg *.webp *.woff *.woff2
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@revalidate path *.js *.css
	header @revalidate Cache-Control "no-cache"

	# SPA fallback — sirve index.html para rutas sin archivo.
	try_files {path} /index.html

	file_server
}
